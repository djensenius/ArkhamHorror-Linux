{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/game-list.schema.json",
  "title": "GameList",
  "description": "Games visible to the authenticated account, ordered by most recently updated.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "$ref": "#/$defs/gameDetails"
      },
      {
        "$ref": "#/$defs/failedGameDetails"
      }
    ]
  },
  "$defs": {
    "failedGameDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "gameDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "campaign",
        "gameState",
        "outcome",
        "name",
        "investigators",
        "otherInvestigators",
        "multiplayerVariant",
        "hasOpenSeats"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scenario": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "difficulty",
            "name",
            "variant"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "difficulty": {
              "$ref": "#/$defs/difficulty"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "campaign": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "difficulty",
            "currentCampaignMode"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "difficulty": {
              "$ref": "#/$defs/difficulty"
            },
            "currentCampaignMode": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "TheDreamQuest",
                "TheWebOfDreams",
                null
              ]
            }
          }
        },
        "gameState": {
          "$ref": "./game-state.schema.json"
        },
        "outcome": {
          "description": "How a finished game ended: null while the game is unfinished, or when no verdict was recorded and none can be inferred.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/gameOutcome"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "investigators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/investigator"
          }
        },
        "otherInvestigators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/investigator"
          }
        },
        "multiplayerVariant": {
          "$ref": "#/$defs/multiplayerVariant"
        },
        "hasOpenSeats": {
          "type": "boolean"
        }
      }
    },
    "gameOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "certainty",
        "note",
        "ending",
        "source"
      ],
      "properties": {
        "result": {
          "enum": [
            "Won",
            "Lost"
          ]
        },
        "certainty": {
          "enum": [
            "Certain",
            "Uncertain"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "An i18n key for the clause the Campaign Guide attaches to the verdict, if any."
        },
        "ending": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "resolution"
              ],
              "properties": {
                "scenario": {
                  "type": "string"
                },
                "resolution": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tag"
                      ],
                      "properties": {
                        "tag": {
                          "const": "NoResolution"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tag",
                        "contents"
                      ],
                      "properties": {
                        "tag": {
                          "const": "Resolution"
                        },
                        "contents": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "source": {
          "enum": [
            "Recorded",
            "Inferred"
          ],
          "description": "Recorded verdicts were declared by the ending itself; Inferred ones were reconstructed afterwards and can be wrong."
        }
      }
    },
    "investigator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classSymbol"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "classSymbol": {
          "enum": [
            "Guardian",
            "Seeker",
            "Survivor",
            "Rogue",
            "Mystic",
            "Neutral",
            "Mythos"
          ]
        }
      }
    },
    "difficulty": {
      "enum": [
        "Easy",
        "Standard",
        "Hard",
        "Expert"
      ]
    },
    "multiplayerVariant": {
      "enum": [
        "Solo",
        "WithFriends"
      ]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
